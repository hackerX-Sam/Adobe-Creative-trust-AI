{
  "name": "adobe-creativetrust-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n API,WEB \"node --env-file=.env server/dev.js\" \"vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:init": "node --env-file=.env server/init-db.js",
    "dev:api": "node --env-file=.env server/dev.js",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:server": "node --check server/app.js && node --check server/seed.js && node --check server/init-db.js && node --check server/dev.js && node --check \"api/index.js\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@neondatabase/serverless": "^1.2.0",
    "concurrently": "^10.0.7",
    "hono": "^4.13.17",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.11.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "postcss": "^8.4.47",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8"
  }
}
