# Neon Postgres connection string.
# 1. Create a project at https://neon.tech
# 2. Copy the connection string from the dashboard ("Connection Details", pooled connection)
# 3. Paste it here (local dev) and into Vercel → Project → Settings → Environment Variables
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# ── Google OAuth (production / Vercel only) ──────────────────────────────────
# 1. console.cloud.google.com → create project → OAuth consent screen (External)
# 2. Credentials → Create OAuth client ID → Web application
# 3. Authorized redirect URI:  https://<your-vercel-domain>/api/auth/google/callback
# 4. Add the client ID + secret here (local) and in Vercel → Settings → Environment Variables.
#    Sign-in is only active where these two variables exist (the live site).
# Optional: pin the public origin when running behind a different host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PUBLIC_ORIGIN=https://adobectai.vercel.app
